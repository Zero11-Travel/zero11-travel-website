# Site
SITE_URL=https://www.zero11travel.co.za

# Email transport
# ----------------------------------------------------------------------------
# All providers send over an HTTP REST API (so they work on Netlify AND
# Cloudflare Workers) EXCEPT Gmail, which has no API-key REST endpoint and so
# still goes over SMTP via nodemailer — Gmail is Netlify/Node only, NOT Cloudflare.
#
# Selection: if RESEND_API_KEY is set it is always used (SMTP/other providers
# ignored). Otherwise DEFAULT_EMAIL_PROVIDER picks the provider.
# DEFAULT_EMAIL_FROM must be an address on a domain verified with that provider.
#
#   resend   | mailgun | sendgrid | mailtrap | zoho (ZeptoMail)  -> REST (any platform)
#   gmail    -> SMTP via nodemailer (Netlify only; default when nothing else set)
DEFAULT_EMAIL_PROVIDER=gmail

# --- Resend (recommended for both platforms) ---
# Set this and it wins regardless of DEFAULT_EMAIL_PROVIDER.
RESEND_API_KEY=

# --- Mailgun --- (REST)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.zero11travel.co.za
# MAILGUN_REGION=eu            # set to 'eu' for EU-region Mailgun accounts

# --- SendGrid --- (REST)
SENDGRID_API_KEY=

# --- Mailtrap --- (REST)
MAILTRAP_API_TOKEN=
# MAILTRAP_INBOX_ID=           # set to use the Sandbox (testing) endpoint

# --- Zoho ZeptoMail --- (REST)
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_REGION=eu          # set to 'eu' for EU-region ZeptoMail accounts

# --- Gmail (SMTP via nodemailer — Netlify only) ---
SMTP_GMAIL_HOST=smtp.gmail.com
SMTP_GMAIL_PORT=587
SMTP_GMAIL_SECURE=false
SMTP_GMAIL_USER=your-email@gmail.com
SMTP_GMAIL_PASS=your-app-password

# Email defaults
DEFAULT_EMAIL_FROM=noreply@zero11travel.co.za
DEFAULT_EMAIL_TO=kgothatso@zero11travel.co.za
CONTACT_EMAIL=kgothatso@zero11travel.co.za

# reCAPTCHA (optional — form works without it, verification is skipped if unset)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Anti-spam tuning (optional, sensible defaults apply)
ANTISPAM_EMAIL_LIMIT=10
ANTISPAM_EMAIL_DURATION=3600
ANTISPAM_MAX_LINKS=5
ANTISPAM_MAX_RECIPIENTS=10
ANTISPAM_MAX_CAPS_RATIO=0.7

# Remarketing / analytics (optional — the cookie consent banner still shows,
# but no tracking script loads until these are set AND the visitor consents)
# GTM container hosts both GA4 and Google Ads Remarketing tags — configure
# those two tags inside the Google Tag Manager dashboard, not here.
GTM_CONTAINER_ID=
META_PIXEL_ID=
