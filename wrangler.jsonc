// Cloudflare Pages config, used by `wrangler pages deploy` / `wrangler pages dev`
// (same workflow as the sylvester_solutions project). Build with
// `pnpm build:cloudflare` (Nitro preset cloudflare_pages -> dist/), deploy with
// `pnpm deploy:cloudflare`.
// Secrets (RESEND_API_KEY, DEFAULT_EMAIL_FROM, DEFAULT_EMAIL_TO, RECAPTCHA_SECRET_KEY, ...)
// are NOT stored here: `wrangler pages secret put <KEY> --project-name=zero11-travel-tours`.
{
  "name": "zero11-travel-tours",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"]
}
