// Cloudflare Workers deployment config. Nitro's cloudflare_module preset
// (selected by `pnpm build:cloudflare`) merges this into the generated
// .output/server/wrangler.json and adds the static-assets binding.
// Secrets (SMTP_*, RESEND_API_KEY, RECAPTCHA_SECRET_KEY...) are NOT stored here —
// set them in the Cloudflare dashboard or with `wrangler secret put`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero11-travel-tours",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
}
