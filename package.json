{
  "name": "zero11-travel-tours",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "nuxt build",
    "build:netlify": "cross-env NITRO_PRESET=netlify nuxt build",
    "build:static": "cross-env STATIC_SITE=true nuxt generate && node scripts/finalize-static.mjs",
    "build:cloudflare": "cross-env NITRO_PRESET=cloudflare_pages nuxt build && node -e \"require('fs').rmSync('dist/_worker.js/wrangler.json',{force:true})\"",
    "preview:cloudflare": "wrangler pages dev dist",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler pages deploy dist --project-name=zero11-travel-tours",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.1",
    "nodemailer": "^10.0.10",
    "nuxt": "^4.3.0",
    "rate-limiter-flexible": "^5.0.3",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@heroicons/vue": "^2.2.0",
    "@nuxt/eslint": "^1.13.0",
    "@nuxt/icon": "^2.2.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/robots": "^6.0.9",
    "@nuxtjs/sitemap": "^8.0.15",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/nodemailer": "^8.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "nuxt-schema-org": "^6.0.4",
    "typescript": "^5.6.0",
    "wrangler": "^4.145.0"
  }
}
